{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haohsk",
  "main": "worker/standalone.mjs",
  "account_id": "b2bae3f2ba7e09ab0223cd93a8d2f5a2",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "a83768bc-63e2-46f6-bb9f-c34313308144"
    }
  ]
}
